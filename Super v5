double gCurrentLot = 0;

string gLotGVName = "";

ulong gRecoveryPendingPosition = 0;

//+------------------------------------------------------------------+
//| INITIALIZATION                                                   |
//+------------------------------------------------------------------+
int OnInit()
{
   if(Period() != PERIOD_M1)
      Print("[WARN] EA ini dioptimasi untuk M1. TF saat ini: ",
            EnumToString((ENUM_TIMEFRAMES)Period()));

   hEma = iMA(
      _Symbol,
      _Period,
      TrendEMAPeriod,
      0,
      MODE_EMA,
      PRICE_CLOSE
   );

   hAtr = iATR(
      _Symbol,
      _Period,
      TrendATRPeriod
   );

   if(UseHTFFilter)
   {
      hHtfEma = iMA(
         _Symbol,
         HTF,
         HTFEMAPeriod,
         0,
         MODE_EMA,
         PRICE_CLOSE
      );
   }

   if(hEma == INVALID_HANDLE ||
      hAtr == INVALID_HANDLE ||
      (UseHTFFilter && hHtfEma == INVALID_HANDLE))
   {
      Print("Error membuat indicator handle");
      return INIT_FAILED;
   }

   gPeakEquity = AccountInfoDouble(ACCOUNT_EQUITY);

   //==================== AUTO LOT RECOVERY ====================

   gLotGVName = StringFormat(
      "NSM_%I64d_%d_%s",
      AccountInfoInteger(ACCOUNT_LOGIN),
      MagicNumber,
      _Symbol
   );

   if(GlobalVariableCheck(gLotGVName))
      gCurrentLot = GlobalVariableGet(gLotGVName);
   else
   {
      gCurrentLot = FixedLot;
      GlobalVariableSet(gLotGVName, gCurrentLot);
   }

   Print("[LOT RECOVERY] Current lot: ", gCurrentLot);

   EventSetTimer(1);

   Print(
      "NyaoScalpM1 aktif. Symbol=",
      _Symbol,
      " TF=",
      EnumToString((ENUM_TIMEFRAMES)Period())
   );

   return INIT_SUCCEEDED;
}

//+------------------------------------------------------------------+
//| AUTO LOT RECOVERY                                                |
//+------------------------------------------------------------------+
void UpdateRecoveryLot(bool isSL)
{
   if(!EnableAutoLotRecovery)
      return;

   if(isSL)
   {
      double multiplier = MathMax(1.0, LotMultiplier);
      double cap = MathMax(FixedLot, MaxRecoveryLot);

      gCurrentLot = MathMin(gCurrentLot * multiplier, cap);

      Print("[LOT RECOVERY] SL. Next lot: ", gCurrentLot);
   }
   else
   {
      gCurrentLot = FixedLot;

      Print("[LOT RECOVERY] TP. Reset lot: ", gCurrentLot);
   }

   GlobalVariableSet(gLotGVName, gCurrentLot);
}

//+------------------------------------------------------------------+
//| CEK POSITION ID MASIH TERBUKA                                    |
//+------------------------------------------------------------------+
bool IsPositionIdentifierOpen(ulong positionId)
{
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket == 0)
         continue;

      if((ulong)PositionGetInteger(POSITION_IDENTIFIER) == positionId)
         return true;
   }

   return false;
}

//+------------------------------------------------------------------+
//| PROSES RECOVERY SETELAH POSISI TERTUTUP                          |
//+------------------------------------------------------------------+
void ProcessRecoveryPending()
{
   if(!EnableAutoLotRecovery)
      return;

   ulong positionId = gRecoveryPendingPosition;

   if(positionId == 0)
      return;

   if(IsPositionIdentifierOpen(positionId))
      return;

   string doneKey = StringFormat("NSM_DONE_%I64u", positionId);

   if(GlobalVariableCheck(doneKey))
   {
      gRecoveryPendingPosition = 0;
      return;
   }

   if(!HistorySelectByPosition(positionId))
   {
      Print("[RECOVERY] History belum tersedia. ID=", positionId);
      return;
   }

   double netProfit = 0.0;
   bool isOurPosition = false;

   int totalDeals = HistoryDealsTotal();

   for(int i = 0; i < totalDeals; i++)
   {
      ulong deal = HistoryDealGetTicket(i);
      if(deal == 0)
         continue;

      long magic = HistoryDealGetInteger(deal, DEAL_MAGIC);

      if(magic == MagicNumber)
         isOurPosition = true;

      netProfit += HistoryDealGetDouble(deal, DEAL_PROFIT);
      netProfit += HistoryDealGetDouble(deal, DEAL_SWAP);
      netProfit += HistoryDealGetDouble(deal, DEAL_COMMISSION);
      netProfit += HistoryDealGetDouble(deal, DEAL_FEE);
   }

   Print(
      "[RECOVERY DEBUG] ID=", positionId,
      " Deals=", totalDeals,
      " Own=", isOurPosition,
      " Net=", DoubleToString(netProfit, 2),
      " LotBefore=", DoubleToString(gCurrentLot, 2)
   );

   if(!isOurPosition)
   {
      Print("[RECOVERY] Magic belum ditemukan. Menunggu ulang.");
      return;
   }

   if(netProfit > 0.000001)
   {
      gCurrentLot = FixedLot;

      Print(
         "[RECOVERY] TP/PROFIT -> RESET LOT ",
         DoubleToString(gCurrentLot, 2)
      );
   }
   else if(netProfit < -0.000001)
   {
      double multiplier = MathMax(1.0, LotMultiplier);
      double cap = MathMax(FixedLot, MaxRecoveryLot);

      gCurrentLot = MathMin(gCurrentLot * multiplier, cap);

      Print(
         "[RECOVERY] SL/LOSS -> NEXT LOT ",
         DoubleToString(gCurrentLot, 2)
      );
   }
   else
   {
      Print("[RECOVERY] BREAK EVEN -> LOT TETAP");
   }

   GlobalVariableSet(gLotGVName, gCurrentLot);
   GlobalVariableSet(doneKey, (double)TimeCurrent());

   GlobalVariablesFlush();

   Print(
      "[RECOVERY FINAL] Saved lot=",
      DoubleToString(GlobalVariableGet(gLotGVName), 2)
   );

   gRecoveryPendingPosition = 0;
}

//+------------------------------------------------------------------+
//| DETEKSI TRANSAKSI PENUTUPAN                                      |
//+------------------------------------------------------------------+
void OnTradeTransaction(
   const MqlTradeTransaction &trans,
   const MqlTradeRequest &request,
   const MqlTradeResult &result
)
{
   if(!EnableAutoLotRecovery)
      return;

   if(trans.type != TRADE_TRANSACTION_DEAL_ADD)
      return;

   if(trans.deal == 0)
      return;

   if(!HistoryDealSelect(trans.deal))
      return;

   long entry = HistoryDealGetInteger(trans.deal, DEAL_ENTRY);

   if(entry != DEAL_ENTRY_OUT &&
      entry != DEAL_ENTRY_OUT_BY &&
      entry != DEAL_ENTRY_INOUT)
      return;

   ulong positionId = (ulong)HistoryDealGetInteger(
      trans.deal,
      DEAL_POSITION_ID
   );

   if(positionId == 0)
      return;

   gRecoveryPendingPosition = positionId;

   Print(
      "[RECOVERY] Penutupan terdeteksi. Menunggu finalisasi: ",
      positionId
   );

   ProcessRecoveryPending();
}

//+------------------------------------------------------------------+
//| DEINITIALIZATION                                                 |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
   EventKillTimer();

   if(hEma != INVALID_HANDLE)
      IndicatorRelease(hEma);

   if(hAtr != INVALID_HANDLE)
      IndicatorRelease(hAtr);

   if(hHtfEma != INVALID_HANDLE)
      IndicatorRelease(hHtfEma);

   Comment("");
}

