      UpdateDashboard();
}

//+------------------------------------------------------------------+
//| MAIN TICK                                                        |
//+------------------------------------------------------------------+
void OnTick()
{
   UpdateSpread();

   ManageTrailing();

   ProcessRecoveryPending();

   if(EnableAutoLotRecovery && gRecoveryPendingPosition != 0)
   {
      gLastAction = "waiting: lot recovery";
      SetAction();
      return;
   }

   if(ShowDashboard)
      UpdateDashboard();

   datetime currentBar = iTime(_Symbol, _Period, 0);

   if(currentBar == 0)
      return;

   if(EntryMode == ENTRY_CANDLE_CLOSE)
   {
      if(currentBar == lastBarTime)
         return;

      lastBarTime = currentBar;
   }

   if(lastEntryBarTime == currentBar)
      return;

   if(!IsWithinTradingHours())
   {
      gLastAction = "blocked: time";
      SetAction();
      return;
   }

   if(IsSpreadTooWide())
   {
      gLastAction = "blocked: spread";
      SetAction();
      return;
   }

   int signalShift = (EntryMode == ENTRY_INSTANT) ? 0 : 1;

   if(!ComputeSignals(
      signalShift,
      gBuyScore,
      gSellScore,
      gBuyReason,
      gSellReason
   ))
      return;

   gPositions = CountPositions();
   gExposure = gPositions + CountPendingOrders();

   int maxExposure = EnableAutoLotRecovery ? 1 : MaxPositions;

   if(gExposure >= maxExposure)
   {
      gLastAction = "blocked: max exposure";
      SetAction();
      return;
   }

   bool htfUp = false;
   bool htfDn = false;

   if(UseHTFFilter)
      GetHTFDirection(htfUp, htfDn);

   //==================== AUTO REVERSAL ====================

   ENUM_ORDER_TYPE signalType = ORDER_TYPE_BUY;
   bool validSignal = false;

   if(gBuyScore > gSellScore)
   {
      if(gBuyScore >= MinBuyScore || AutoEntryWhenEmpty)
      {
         signalType = ORDER_TYPE_BUY;
         validSignal = true;
      }
   }
   else if(gSellScore > gBuyScore)
   {
      if(gSellScore >= MinSellScore || AutoEntryWhenEmpty)
      {
         signalType = ORDER_TYPE_SELL;
         validSignal = true;
      }
   }

   if(!validSignal)
   {
      gLastAction = StringFormat(
         "wait: B%.1f S%.1f",
         gBuyScore,
         gSellScore
      );

      SetAction();
      return;
   }

   ENUM_ORDER_TYPE orderType = signalType;

   if(AutoReversal)
   {
      orderType = (signalType == ORDER_TYPE_BUY)
                  ? ORDER_TYPE_SELL
                  : ORDER_TYPE_BUY;
   }

   // HTF mengikuti arah transaksi aktual

   if(UseHTFFilter)
   {
      if(orderType == ORDER_TYPE_BUY && !htfUp)
      {
         gLastAction = "blocked: HTF down";
         SetAction();
         return;
      }

      if(orderType == ORDER_TYPE_SELL && !htfDn)
      {
         gLastAction = "blocked: HTF up";
         SetAction();
         return;
      }
   }

   if(OpenTrade(orderType))
   {
      lastEntryBarTime = currentBar;

      gLastAction = (orderType == ORDER_TYPE_BUY)
                    ? "BUY opened"
                    : "SELL opened";

      if(AutoReversal)
         gLastAction += " [REVERSAL]";

      SetAction();
   }
}

