      " BALANCE         : " + DoubleToString(bal, 2) + "\n"
      " EQUITY          : " + DoubleToString(eq, 2) + "\n"
      " FREE MARGIN     : " + DoubleToString(freeM, 2) + "\n"
      " PEAK DRAWDOWN   : " + DoubleToString(ddPct, 2) + "%\n"
      "\n"
