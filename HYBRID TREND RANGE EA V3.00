//+------------------------------------------------------------------+
//|              HYBRID TREND RANGE EA V3.00                         |
//|              MT5 EXPERT ADVISOR                                  |
//|              TREND + RANGE + RISK PROTECTION                     |
//+------------------------------------------------------------------+
#property strict
#property version "3.00"

#include <Trade/Trade.mqh>

CTrade trade;

//==================== GENERAL ====================

input group "=== GENERAL ==="
input double RiskPercent = 1.0;
input double FixedLot = 0.01;
input bool UseRiskPercent = true;
input int MagicNumber = 20261109;
input int MaxPositions = 1;

input bool AllowBuy = true;
input bool AllowSell = true;

//==================== TIMEFRAME ====================

input group "=== TIMEFRAME ==="
input ENUM_TIMEFRAMES SignalTF = PERIOD_M15;

//==================== SIGNAL FREQUENCY ====================

input group "=== SIGNAL FREQUENCY ==="
input int MinBarsBetweenSignals = 1;
input int CooldownMinutes = 1;
input int MaxTradesPerDay = 30;

//==================== TREND ====================

input group "=== TREND SETTINGS ==="
input bool EnableTrend = true;
input int FastEMA = 50;
input int SlowEMA = 200;
input int ADXPeriod = 14;
input double ADXTrend = 25.0;

//==================== RANGE ====================

input group "=== RANGE SETTINGS ==="
input bool EnableRange = true;
input double ADXRange = 20.0;
input int RSIPeriod = 14;
input double RSI_Buy = 35.0;
input double RSI_Sell = 65.0;
input int BBPeriod = 20;
input double BBDeviation = 2.0;

//==================== CANDLE CONFIRMATION ====================

input group "=== CANDLE CONFIRMATION ==="
input bool ConfirmCandle = false;

//==================== VOLATILITY FILTER ====================

input group "=== ATR FILTER ==="
input double MinATR = 0.0;
input double MaxATR = 0.0;

// 0 = disabled

//==================== RISK ====================

input group "=== RISK MANAGEMENT ==="
input int ATRPeriod = 14;
input double SL_ATR = 1.5;
input double TP_ATR = 2.25;

//==================== BREAK EVEN ====================

input group "=== BREAK EVEN ==="
input bool UseBreakEven = true;
input double BreakEvenATR = 1.0;
input double BreakEvenOffsetPoints = 5;

//==================== TRAILING ====================

input group "=== TRAILING STOP ==="
input bool UseTrailing = true;
input double TrailStartATR = 1.0;
input double TrailATR = 1.0;

//==================== PARTIAL CLOSE ====================

input group "=== PARTIAL CLOSE ==="
input bool UsePartialClose = false;
input double PartialCloseAtATR = 1.5;
input double PartialClosePercent = 50.0;

//==================== DAILY PROTECTION ====================

input group "=== DAILY PROTECTION ==="
input bool StopAfterDailyLoss = true;
input double MaxDailyLoss = 3.0;

input bool StopAfterDailyProfit = false;
input double DailyProfitTarget = 5.0;

input int MaxConsecutiveLoss = 3;

//==================== TRADING SESSION ====================

input group "=== TRADING SESSION ==="
input bool EnableSessionFilter = false;
input int StartHour = 6;
input int EndHour = 22;

//==================== EXECUTION ====================

input group "=== EXECUTION ==="
input int MaxSpreadPoints = 80;
input int SlippagePoints = 20;

//==================== INDICATORS ====================

int hFastEMA;
int hSlowEMA;
int hADX;
int hRSI;
int hBB;
int hATR;

datetime lastBar = 0;
datetime lastSignalBarTime = 0;
datetime lastEntryTime = 0;

//==================== DAILY DATA ====================

double dailyClosedProfit = 0;
double dailyFloatingProfit = 0;
double dailyStartBalance = 0;

int dailyTrades = 0;
int consecutiveLosses = 0;

bool dailyLossReached = false;
bool dailyProfitReached = false;

//==================== INIT ====================

int OnInit()
{
   trade.SetExpertMagicNumber(MagicNumber);
   trade.SetDeviationInPoints(SlippagePoints);
   trade.SetTypeFillingBySymbol(_Symbol);

   hFastEMA = iMA(
      _Symbol, SignalTF, FastEMA,
      0, MODE_EMA, PRICE_CLOSE
   );

   hSlowEMA = iMA(
      _Symbol, SignalTF, SlowEMA,
      0, MODE_EMA, PRICE_CLOSE
   );

   hADX = iADX(
      _Symbol, SignalTF, ADXPeriod
   );

   hRSI = iRSI(
      _Symbol, SignalTF, RSIPeriod,
      PRICE_CLOSE
   );

   hBB = iBands(
      _Symbol, SignalTF, BBPeriod,
      0, BBDeviation, PRICE_CLOSE
   );

   hATR = iATR(
      _Symbol, SignalTF, ATRPeriod
   );

   if(hFastEMA == INVALID_HANDLE ||
      hSlowEMA == INVALID_HANDLE ||
      hADX == INVALID_HANDLE ||
      hRSI == INVALID_HANDLE ||
      hBB == INVALID_HANDLE ||
      hATR == INVALID_HANDLE)
   {
      Print("Indicator initialization failed");
      return INIT_FAILED;
   }

   UpdateDailyStats();

   Print("HYBRID TREND RANGE EA V3 READY");

   return INIT_SUCCEEDED;
}

//==================== DEINIT ====================

void OnDeinit(const int reason)
{
   IndicatorRelease(hFastEMA);
   IndicatorRelease(hSlowEMA);
   IndicatorRelease(hADX);
   IndicatorRelease(hRSI);
   IndicatorRelease(hBB);
   IndicatorRelease(hATR);

   Comment("");
}

//==================== GET BUFFER ====================

double GetBuffer(int handle, int buffer, int shift)
{
   double data[];

   ArraySetAsSeries(data, true);

   if(CopyBuffer(handle, buffer, shift, 1, data) != 1)
      return EMPTY_VALUE;

   return data[0];
}

//==================== CALCULATE LOT ====================

double CalculateLot(double slDistance)
{
   double lot = FixedLot;

   if(UseRiskPercent)
   {
      double balance =
         AccountInfoDouble(ACCOUNT_BALANCE);

      double riskMoney =
         balance * RiskPercent / 100.0;

      double tickValue =
         SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);

      double tickSize =
         SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);

      if(tickValue <= 0 || tickSize <= 0)
         return 0;

      double lossPerLot =
         (slDistance / tickSize) * tickValue;

      if(lossPerLot <= 0)
         return 0;

      lot = riskMoney / lossPerLot;
   }

   double minLot =
      SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);

   double maxLot =
      SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);

   double step =
      SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);

   if(step <= 0 || lot < minLot)
      return 0;

   lot = MathMin(lot, maxLot);
   lot = MathFloor(lot / step) * step;

   int digits = 2;

   if(step >= 1.0)
      digits = 0;
   else if(step >= 0.1)
      digits = 1;
   else if(step >= 0.01)
      digits = 2;
   else
      digits = 3;

   return NormalizeDouble(lot, digits);
}

//==================== COUNT POSITIONS ====================

int CountPositions()
{
   int count = 0;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(PositionGetString(POSITION_SYMBOL) == _Symbol &&
         PositionGetInteger(POSITION_MAGIC) == MagicNumber)
      {
         count++;
      }
   }

   return count;
}

//==================== DAILY STATISTICS ====================

void UpdateDailyStats()
{
   MqlDateTime dt;

   TimeToStruct(TimeCurrent(), dt);

   dt.hour = 0;
   dt.min = 0;
   dt.sec = 0;

   datetime dayStart = StructToTime(dt);

   dailyClosedProfit = 0;
   dailyFloatingProfit = 0;
   dailyTrades = 0;
   consecutiveLosses = 0;

   if(!HistorySelect(dayStart, TimeCurrent()))
      return;

   int total = HistoryDealsTotal();

   // DAILY PROFIT AND TRADE COUNT

   for(int i = 0; i < total; i++)
   {
      ulong ticket = HistoryDealGetTicket(i);

      if(ticket == 0)
         continue;

      if(HistoryDealGetString(ticket, DEAL_SYMBOL) != _Symbol)
         continue;

      if(HistoryDealGetInteger(ticket, DEAL_MAGIC) != MagicNumber)
         continue;

      ENUM_DEAL_ENTRY entry =
         (ENUM_DEAL_ENTRY)HistoryDealGetInteger(
            ticket, DEAL_ENTRY
         );

      double profit =
         HistoryDealGetDouble(ticket, DEAL_PROFIT);

      double swap =
         HistoryDealGetDouble(ticket, DEAL_SWAP);

      double commission =
         HistoryDealGetDouble(ticket, DEAL_COMMISSION);

      dailyClosedProfit += profit + swap + commission;

      if(entry == DEAL_ENTRY_IN ||
         entry == DEAL_ENTRY_INOUT)
      {
         dailyTrades++;
      }
   }

   // CONSECUTIVE LOSSES

   for(int i = total - 1; i >= 0; i--)
   {
      ulong ticket = HistoryDealGetTicket(i);

      if(ticket == 0)
         continue;

      if(HistoryDealGetString(ticket, DEAL_SYMBOL) != _Symbol)
         continue;

      if(HistoryDealGetInteger(ticket, DEAL_MAGIC) != MagicNumber)
         continue;

      ENUM_DEAL_ENTRY entry =
         (ENUM_DEAL_ENTRY)HistoryDealGetInteger(
            ticket, DEAL_ENTRY
         );

      if(entry != DEAL_ENTRY_OUT &&
         entry != DEAL_ENTRY_OUT_BY)
         continue;

      double netProfit =
         HistoryDealGetDouble(ticket, DEAL_PROFIT) +
         HistoryDealGetDouble(ticket, DEAL_SWAP) +
         HistoryDealGetDouble(ticket, DEAL_COMMISSION);

      if(netProfit < 0)
      {
         consecutiveLosses++;
      }
      else
      {
         break;
      }
   }

   // FLOATING PROFIT

   dailyFloatingProfit = 0;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(PositionGetString(POSITION_SYMBOL) != _Symbol ||
         PositionGetInteger(POSITION_MAGIC) != MagicNumber)
         continue;

      dailyFloatingProfit +=
         PositionGetDouble(POSITION_PROFIT) +
         PositionGetDouble(POSITION_SWAP);
   }

   // START BALANCE

   dailyStartBalance =
      AccountInfoDouble(ACCOUNT_BALANCE) -
      dailyClosedProfit;

   if(dailyStartBalance <= 0)
      dailyStartBalance =
         AccountInfoDouble(ACCOUNT_BALANCE);

   double dailyNet =
      dailyClosedProfit + dailyFloatingProfit;

   double dailyPercent =
      dailyStartBalance > 0 ?
      dailyNet / dailyStartBalance * 100.0 : 0;

   dailyLossReached =
      StopAfterDailyLoss &&
      MaxDailyLoss > 0 &&
      dailyPercent <= -MaxDailyLoss;

   dailyProfitReached =
      StopAfterDailyProfit &&
      DailyProfitTarget > 0 &&
      dailyPercent >= DailyProfitTarget;
}

//==================== SESSION FILTER ====================

bool IsTradingSession()
{
   if(!EnableSessionFilter)
      return true;

   MqlDateTime dt;

   TimeToStruct(TimeCurrent(), dt);

   if(StartHour == EndHour)
      return true;

   if(StartHour < EndHour)
   {
      return (
         dt.hour >= StartHour &&
         dt.hour < EndHour
      );
   }

   return (
      dt.hour >= StartHour ||
      dt.hour < EndHour
   );
}

//==================== DAILY PROTECTION ====================

bool DailyProtection()
{
   if(dailyLossReached)
      return false;

   if(dailyProfitReached)
      return false;

   if(MaxTradesPerDay > 0 &&
      dailyTrades >= MaxTradesPerDay)
      return false;

   if(MaxConsecutiveLoss > 0 &&
      consecutiveLosses >= MaxConsecutiveLoss)
      return false;

   return true;
}

//==================== NORMALIZE LOT ====================

double NormalizeVolume(double volume)
{
   double step =
      SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);

   double minLot =
      SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);

   double maxLot =
      SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);

   if(step <= 0)
      return 0;

   volume = MathMin(volume, maxLot);
   volume = MathFloor(volume / step) * step;

   int digits = 2;

   if(step >= 1.0)
      digits = 0;
   else if(step >= 0.1)
      digits = 1;
   else if(step >= 0.01)
      digits = 2;
   else
      digits = 3;

   volume = NormalizeDouble(volume, digits);

   if(volume < minLot)
      return 0;

   return volume;
}

//==================== PARTIAL CLOSE ====================

void ManagePartialClose()
{
   if(!UsePartialClose)
      return;

   if(PartialClosePercent <= 0 ||
      PartialClosePercent >= 100)
      return;

   double atr = GetBuffer(hATR, 0, 1);

   if(atr == EMPTY_VALUE || atr <= 0)
      return;

   double trigger =
      atr * PartialCloseAtATR;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(PositionGetString(POSITION_SYMBOL) != _Symbol ||
         PositionGetInteger(POSITION_MAGIC) != MagicNumber)
         continue;

      string key =
         "HYBRID_PARTIAL_" +
         IntegerToString(MagicNumber) + "_" +
         IntegerToString((long)ticket);

      if(GlobalVariableCheck(key))
         continue;

      ENUM_POSITION_TYPE type =
         (ENUM_POSITION_TYPE)PositionGetInteger(
            POSITION_TYPE
         );

      double openPrice =
         PositionGetDouble(POSITION_PRICE_OPEN);

      double volume =
         PositionGetDouble(POSITION_VOLUME);

      double bid =
         SymbolInfoDouble(_Symbol, SYMBOL_BID);

      double ask =
         SymbolInfoDouble(_Symbol, SYMBOL_ASK);

      double profitDistance = 0;

      if(type == POSITION_TYPE_BUY)
         profitDistance = bid - openPrice;

      else if(type == POSITION_TYPE_SELL)
         profitDistance = openPrice - ask;

      if(profitDistance < trigger)
         continue;

      double minLot =
         SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);

      double closeVolume =
         NormalizeVolume(
            volume * PartialClosePercent / 100.0
         );

      if(closeVolume <= 0)
         continue;

      if(volume - closeVolume < minLot)
         continue;

      if(trade.PositionClosePartial(
         ticket, closeVolume))
      {
         GlobalVariableSet(key, 1);

         Print(
            "PARTIAL CLOSE SUCCESS | Ticket: ",
            ticket,
            " | Volume: ",
            closeVolume
         );
      }
   }
}

//==================== BREAK EVEN ====================

void ManageBreakEven()
{
   if(!UseBreakEven)
      return;

   double atr = GetBuffer(hATR, 0, 1);

   if(atr == EMPTY_VALUE || atr <= 0)
      return;

   double trigger =
      atr * BreakEvenATR;

   double offset =
      BreakEvenOffsetPoints * _Point;

   double bid =
      SymbolInfoDouble(_Symbol, SYMBOL_BID);

   double ask =
      SymbolInfoDouble(_Symbol, SYMBOL_ASK);

   double point =
      SymbolInfoDouble(_Symbol, SYMBOL_POINT);

   int stopLevel =
      (int)SymbolInfoInteger(
         _Symbol, SYMBOL_TRADE_STOPS_LEVEL
      );

   double minDistance = stopLevel * point;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(PositionGetString(POSITION_SYMBOL) != _Symbol ||
         PositionGetInteger(POSITION_MAGIC) != MagicNumber)
         continue;

      ENUM_POSITION_TYPE type =
         (ENUM_POSITION_TYPE)PositionGetInteger(
            POSITION_TYPE
         );

      double openPrice =
         PositionGetDouble(POSITION_PRICE_OPEN);

      double oldSL =
         PositionGetDouble(POSITION_SL);

      double tp =
         PositionGetDouble(POSITION_TP);

      if(type == POSITION_TYPE_BUY)
      {
         if(bid - openPrice < trigger)
            continue;

         double newSL =
            NormalizeDouble(
               openPrice + offset, _Digits
            );

         if(bid - newSL < minDistance)
            continue;

         if((oldSL == 0 || newSL > oldSL + point) &&
            newSL < bid)
         {
            trade.PositionModify(
               ticket, newSL, tp
            );
         }
      }

      else if(type == POSITION_TYPE_SELL)
      {
         if(openPrice - ask < trigger)
            continue;

         double newSL =
            NormalizeDouble(
               openPrice - offset, _Digits
            );

         if(newSL - ask < minDistance)
            continue;

         if((oldSL == 0 || newSL < oldSL - point) &&
            newSL > ask)
         {
            trade.PositionModify(
               ticket, newSL, tp
            );
         }
      }
   }
}

//==================== TRAILING STOP ====================

void ManageTrailing()
{
   if(!UseTrailing)
      return;

   double atr = GetBuffer(hATR, 0, 1);

   if(atr == EMPTY_VALUE || atr <= 0)
      return;

   double distance =
      atr * TrailATR;

   double trigger =
      atr * TrailStartATR;

   double bid =
      SymbolInfoDouble(_Symbol, SYMBOL_BID);

   double ask =
      SymbolInfoDouble(_Symbol, SYMBOL_ASK);

   double point =
      SymbolInfoDouble(_Symbol, SYMBOL_POINT);

   int stopLevel =
      (int)SymbolInfoInteger(
         _Symbol, SYMBOL_TRADE_STOPS_LEVEL
      );

   double minDistance =
      stopLevel * point;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(PositionGetString(POSITION_SYMBOL) != _Symbol ||
         PositionGetInteger(POSITION_MAGIC) != MagicNumber)
         continue;

      ENUM_POSITION_TYPE type =
         (ENUM_POSITION_TYPE)PositionGetInteger(
            POSITION_TYPE
         );

      double openPrice =
         PositionGetDouble(POSITION_PRICE_OPEN);

      double oldSL =
         PositionGetDouble(POSITION_SL);

      double tp =
         PositionGetDouble(POSITION_TP);

      if(type == POSITION_TYPE_BUY)
      {
         if(bid - openPrice < trigger)
            continue;

         double newSL =
            NormalizeDouble(
               bid - distance, _Digits
            );

         if(bid - newSL < minDistance)
            continue;

         if((oldSL == 0 || newSL > oldSL + point) &&
            newSL < bid)
         {
            trade.PositionModify(
               ticket, newSL, tp
            );
         }
      }

      else if(type == POSITION_TYPE_SELL)
      {
         if(openPrice - ask < trigger)
            continue;

         double newSL =
            NormalizeDouble(
               ask + distance, _Digits
            );

         if(newSL - ask < minDistance)
            continue;

         if((oldSL == 0 || newSL < oldSL - point) &&
            newSL > ask)
         {
            trade.PositionModify(
               ticket, newSL, tp
            );
         }
      }
   }
}

//==================== MAIN LOGIC ====================

void OnTick()
{
   // MANAGE OPEN POSITIONS

   ManagePartialClose();
   ManageBreakEven();
   ManageTrailing();

   // UPDATE DAILY STATISTICS

   UpdateDailyStats();

   // NEW CANDLE CHECK

   datetime barTime =
      iTime(_Symbol, SignalTF, 0);

   if(barTime == 0 || barTime == lastBar)
      return;

   lastBar = barTime;

   if(Bars(_Symbol, SignalTF) < SlowEMA + 20)
      return;

   // SIGNAL FREQUENCY

   if(lastSignalBarTime > 0)
   {
      int barsPassed = iBarShift(
         _Symbol,
         SignalTF,
         lastSignalBarTime,
         true
      );

      if(barsPassed >= 0 &&
         barsPassed < MinBarsBetweenSignals)
         return;
   }

   // COOLDOWN

   if(lastEntryTime > 0 &&
      CooldownMinutes > 0)
   {
      if(TimeCurrent() - lastEntryTime <
         CooldownMinutes * 60)
         return;
   }

   // DAILY PROTECTION

   if(!DailyProtection())
      return;

   // TRADING SESSION

   if(!IsTradingSession())
      return;

   // SPREAD

   double ask =
      SymbolInfoDouble(_Symbol, SYMBOL_ASK);

   double bid =
      SymbolInfoDouble(_Symbol, SYMBOL_BID);

   double spread =
      (ask - bid) / _Point;

   if(spread > MaxSpreadPoints)
      return;

   // MAX POSITIONS

   if(CountPositions() >= MaxPositions)
      return;

   // INDICATOR DATA

   double fastEMA =
      GetBuffer(hFastEMA, 0, 1);

   double slowEMA =
      GetBuffer(hSlowEMA, 0, 1);

   double adx =
      GetBuffer(hADX, 0, 1);

   double plusDI =
      GetBuffer(hADX, 1, 1);

   double minusDI =
      GetBuffer(hADX, 2, 1);

   double rsi =
      GetBuffer(hRSI, 0, 1);

   double upperBB =
      GetBuffer(hBB, 1, 1);

   double lowerBB =
      GetBuffer(hBB, 2, 1);

   double atr =
      GetBuffer(hATR, 0, 1);

   if(fastEMA == EMPTY_VALUE ||
      slowEMA == EMPTY_VALUE ||
      adx == EMPTY_VALUE ||
      plusDI == EMPTY_VALUE ||
      minusDI == EMPTY_VALUE ||
      rsi == EMPTY_VALUE ||
      upperBB == EMPTY_VALUE ||
      lowerBB == EMPTY_VALUE ||
      atr == EMPTY_VALUE || atr <= 0)
      return;

   // ATR FILTER

   if(MinATR > 0 && atr < MinATR)
      return;

   if(MaxATR > 0 && atr > MaxATR)
      return;

   // CANDLE DATA

   double close =
      iClose(_Symbol, SignalTF, 1);

   double open =
      iOpen(_Symbol, SignalTF, 1);

   double previousClose =
      iClose(_Symbol, SignalTF, 2);

   double previousOpen =
      iOpen(_Symbol, SignalTF, 2);

   bool bullish =
      close > open;

   bool bearish =
      close < open;

   bool previousBullish =
      previousClose > previousOpen;

   bool previousBearish =
      previousClose < previousOpen;

   // CONFIRMATION

   if(ConfirmCandle)
   {
      bullish =
         bullish && previousBullish;

      bearish =
         bearish && previousBearish;
   }

   bool buySignal = false;
   bool sellSignal = false;

   string mode = "NO TRADE";

   //================ TREND FOLLOWING ================

   if(EnableTrend && adx >= ADXTrend)
   {
      mode = "TREND FOLLOWING";

      // BUY TREND

      if(fastEMA > slowEMA &&
         plusDI > minusDI &&
         close > fastEMA &&
         close <= fastEMA + atr * 0.5 &&
         rsi > 50 &&
         bullish)
      {
         buySignal = true;
      }

      // SELL TREND

      if(fastEMA < slowEMA &&
         minusDI > plusDI &&
         close < fastEMA &&
         close >= fastEMA - atr * 0.5 &&
         rsi < 50 &&
         bearish)
      {
         sellSignal = true;
      }
   }

   //================ SIDEWAYS RANGE ================

   else if(EnableRange && adx <= ADXRange)
   {
      mode = "SIDEWAYS RANGE";

      // RANGE BUY

      if(close <= lowerBB &&
         rsi <= RSI_Buy &&
         bullish)
      {
         buySignal = true;
      }

      // RANGE SELL

      if(close >= upperBB &&
         rsi >= RSI_Sell &&
         bearish)
      {
         sellSignal = true;
      }
   }

   //================ SIGNAL DIRECTION ================

   if(!AllowBuy)
      buySignal = false;

   if(!AllowSell)
      sellSignal = false;

   //================ DASHBOARD ====================

   double dailyNet =
      dailyClosedProfit + dailyFloatingProfit;

   double dailyPercent =
      dailyStartBalance > 0 ?
      dailyNet / dailyStartBalance * 100.0 : 0;

   Comment(
      "HYBRID TREND RANGE EA V3.00\n",
      "----------------------------\n",
      "Symbol: ", _Symbol, "\n",
      "Timeframe: ", EnumToString(SignalTF), "\n",
      "Market: ", mode, "\n",
      "ADX: ", DoubleToString(adx, 2), "\n",
      "RSI: ", DoubleToString(rsi, 2), "\n",
      "ATR: ", DoubleToString(atr, _Digits), "\n",
      "Spread: ", DoubleToString(spread, 1), "\n",
      "Positions: ", CountPositions(), "\n",
      "Trades Today: ", dailyTrades, "/", MaxTradesPerDay, "\n",
      "Daily P/L: ", DoubleToString(dailyNet, 2), "\n",
      "Daily P/L %: ", DoubleToString(dailyPercent, 2), "%\n",
      "Consecutive Loss: ", consecutiveLosses, "\n",
      "Daily Loss Stop: ", dailyLossReached ? "ACTIVE" : "OFF", "\n",
      "Daily Profit Stop: ", dailyProfitReached ? "ACTIVE" : "OFF"
   );

   if(!buySignal && !sellSignal)
      return;

   //================ RISK CALCULATION ================

   double slDistance =
      atr * SL_ATR;

   double tpDistance =
      atr * TP_ATR;

   double minStop =
      (double)SymbolInfoInteger(
         _Symbol, SYMBOL_TRADE_STOPS_LEVEL
      ) * _Point;

   slDistance =
      MathMax(slDistance, minStop + 2 * _Point);

   tpDistance =
      MathMax(tpDistance, minStop + 2 * _Point);

   double lot =
      CalculateLot(slDistance);

   if(lot <= 0)
   {
      Print(
         "LOT INVALID: Check risk and broker minimum lot"
      );

      return;
   }

   //================ EXECUTION ====================

   bool result = false;

   if(buySignal)
   {
      double sl =
         NormalizeDouble(
            ask - slDistance, _Digits
         );

      double tp =
         NormalizeDouble(
            ask + tpDistance, _Digits
         );

      result = trade.Buy(
         lot,
         _Symbol,
         0,
         sl,
         tp,
         "HYBRID BUY"
      );
   }

   else if(sellSignal)
   {
      double sl =
         NormalizeDouble(
            bid + slDistance, _Digits
         );

      double tp =
         NormalizeDouble(
            bid - tpDistance, _Digits
         );

      result = trade.Sell(
         lot,
         _Symbol,
         0,
         sl,
         tp,
         "HYBRID SELL"
      );
   }

   //================ RESULT ====================

   if(!result)
   {
      Print(
         "ORDER FAILED: ",
         trade.ResultRetcode(),
         " | ",
         trade.ResultRetcodeDescription()
      );
   }
   else
   {
      if(trade.ResultRetcode() == TRADE_RETCODE_DONE ||
         trade.ResultRetcode() == TRADE_RETCODE_DONE_PARTIAL ||
         trade.ResultRetcode() == TRADE_RETCODE_PLACED)
      {
         lastSignalBarTime = barTime;
         lastEntryTime = TimeCurrent();

         Print(
            "ORDER SUCCESS: ",
            buySignal ? "BUY" : "SELL",
            " | LOT: ", lot,
            " | MODE: ", mode,
            " | DAILY TRADES: ", dailyTrades
         );
      }
   }
}

//+------------------------------------------------------------------+
