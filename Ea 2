//+------------------------------------------------------------------+
//|                 HybridScalpingV4.mq5                             |
//|              XAUUSD Aggressive Signal Mode                       |
//+------------------------------------------------------------------+
#property strict
#property version "4.00"

#include <Trade/Trade.mqh>
CTrade trade;

//====================== SETTINGS ======================

input ENUM_TIMEFRAMES TradeTF = PERIOD_M1;

input double RiskPercent       = 0.5;
input int    MaxPositions      = 3;
input double DailyLossLimit    = 2.0;

input int    FastEMA           = 50;
input int    SlowEMA           = 200;

input int    ADXPeriod         = 14;
input double TrendADX          = 25.0;
input double RangeADX          = 20.0;

input int    RSIPeriod         = 14;
input int    BBPeriod          = 20;
input double BBDeviation       = 2.0;

input int    ATRPeriod         = 14;
input double SL_ATR            = 1.2;
input double TP_ATR            = 1.5;
input double Trail_ATR         = 1.0;

input int    MaxSpreadPoints   = 80;
input ulong  MagicNumber       = 20261109;

//====================== HANDLES ======================

int hFastEMA;
int hSlowEMA;
int hADX;
int hRSI;
int hBB;
int hATR;

datetime lastBar = 0;
double dailyStartEquity = 0;
string dailyKey = "";

//====================== INITIALIZATION ======================

int OnInit()
{
   trade.SetExpertMagicNumber(MagicNumber);
   trade.SetDeviationInPoints(30);

   hFastEMA = iMA(_Symbol, TradeTF, FastEMA, 0, MODE_EMA, PRICE_CLOSE);
   hSlowEMA = iMA(_Symbol, TradeTF, SlowEMA, 0, MODE_EMA, PRICE_CLOSE);
   hADX     = iADX(_Symbol, TradeTF, ADXPeriod);
   hRSI     = iRSI(_Symbol, TradeTF, RSIPeriod, PRICE_CLOSE);
   hBB      = iBands(_Symbol, TradeTF, BBPeriod, 0, BBDeviation, PRICE_CLOSE);
   hATR     = iATR(_Symbol, TradeTF, ATRPeriod);

   if(hFastEMA == INVALID_HANDLE ||
      hSlowEMA == INVALID_HANDLE ||
      hADX == INVALID_HANDLE ||
      hRSI == INVALID_HANDLE ||
      hBB == INVALID_HANDLE ||
      hATR == INVALID_HANDLE)
   {
      Print("❌ Gagal membuat indikator");
      return INIT_FAILED;
   }

   UpdateDailyEquity();

   Print("☑️ HYBRID SCALPING V4 ACTIVE");
   Print("Symbol: ", _Symbol);
   Print("Timeframe: M1");

   return INIT_SUCCEEDED;
}

//====================== DAILY EQUITY ======================

void UpdateDailyEquity()
{
   MqlDateTime dt;
   TimeToStruct(TimeCurrent(), dt);

   dailyKey = StringFormat(
      "HSC4_%I64d_%s_%I64d_%04d%02d%02d",
      AccountInfoInteger(ACCOUNT_LOGIN),
      _Symbol,
      MagicNumber,
      dt.year,
      dt.mon,
      dt.day
   );

   if(!GlobalVariableCheck(dailyKey))
   {
      GlobalVariableSet(
         dailyKey,
         AccountInfoDouble(ACCOUNT_EQUITY)
      );
   }

   dailyStartEquity = GlobalVariableGet(dailyKey);
}

//====================== POSITION COUNT ======================

int CountPositions()
{
   int count = 0;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(PositionGetString(POSITION_SYMBOL) == _Symbol &&
         PositionGetInteger(POSITION_MAGIC) == (long)MagicNumber)
      {
         count++;
      }
   }

   return count;
}

//====================== LOT CALCULATION ======================

double CalculateLot(ENUM_ORDER_TYPE type, double entry, double sl)
{
   double riskMoney =
      AccountInfoDouble(ACCOUNT_EQUITY) * RiskPercent / 100.0;

   double profit = 0;

   if(!OrderCalcProfit(type, _Symbol, 1.0, entry, sl, profit))
      return 0;

   double lossPerLot = MathAbs(profit);

   if(lossPerLot <= 0)
      return 0;

   double lot = riskMoney / lossPerLot;

   double minLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   double maxLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   double step   = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);

   if(step <= 0)
      return 0;

   lot = MathFloor(lot / step) * step;
   lot = MathMax(0, MathMin(lot, maxLot));

   if(lot < minLot)
      return 0;

   int digits = 2;

   if(step == 1.0) digits = 0;
   else if(step == 0.1) digits = 1;
   else if(step == 0.001) digits = 3;

   return NormalizeDouble(lot, digits);
}

//====================== TRAILING STOP ======================

void ManageTrailing()
{
   double atr[];

   ArraySetAsSeries(atr, true);

   if(CopyBuffer(hATR, 0, 0, 2, atr) < 2)
      return;

   double distance = atr[0] * Trail_ATR;

   MqlTick tick;

   if(!SymbolInfoTick(_Symbol, tick))
      return;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(PositionGetString(POSITION_SYMBOL) != _Symbol ||
         PositionGetInteger(POSITION_MAGIC) != (long)MagicNumber)
         continue;

      long type = PositionGetInteger(POSITION_TYPE);

      double oldSL = PositionGetDouble(POSITION_SL);
      double tp    = PositionGetDouble(POSITION_TP);

      if(type == POSITION_TYPE_BUY)
      {
         double newSL = NormalizeDouble(
            tick.bid - distance,
            _Digits
         );

         if((oldSL == 0 || newSL > oldSL) &&
            newSL < tick.bid)
         {
            trade.PositionModify(ticket, newSL, tp);
         }
      }
      else if(type == POSITION_TYPE_SELL)
      {
         double newSL = NormalizeDouble(
            tick.ask + distance,
            _Digits
         );

         if((oldSL == 0 || newSL < oldSL) &&
            newSL > tick.ask)
         {
            trade.PositionModify(ticket, newSL, tp);
         }
      }
   }
}

//====================== MAIN ======================

void OnTick()
{
   ManageTrailing();

   // Cek candle M1 baru
   datetime currentBar = iTime(_Symbol, TradeTF, 0);

   if(currentBar == 0 || currentBar == lastBar)
      return;

   lastBar = currentBar;

   // Update tanggal harian
   MqlDateTime dt;
   TimeToStruct(TimeCurrent(), dt);

   string today = StringFormat(
      "%04d%02d%02d",
      dt.year, dt.mon, dt.day
   );

   if(StringFind(dailyKey, today) < 0)
      UpdateDailyEquity();

   // Batas kerugian harian
   double equity = AccountInfoDouble(ACCOUNT_EQUITY);

   double dailyLoss =
      (dailyStartEquity - equity) /
      dailyStartEquity * 100.0;

   if(dailyLoss >= DailyLossLimit)
   {
      Print("⛔ DAILY LOSS LIMIT: ", dailyLoss, "%");
      return;
   }

   // Batas posisi
   if(CountPositions() >= MaxPositions)
      return;

   // Spread filter
   MqlTick tick;

   if(!SymbolInfoTick(_Symbol, tick))
      return;

   double spread =
      (tick.ask - tick.bid) / _Point;

   if(spread > MaxSpreadPoints)
      return;

   //====================== INDICATORS ======================

   double fast[], slow[], adx[], rsi[];
   double upper[], lower[], atr[];

   ArraySetAsSeries(fast, true);
   ArraySetAsSeries(slow, true);
   ArraySetAsSeries(adx, true);
   ArraySetAsSeries(rsi, true);
   ArraySetAsSeries(upper, true);
   ArraySetAsSeries(lower, true);
   ArraySetAsSeries(atr, true);

   if(CopyBuffer(hFastEMA, 0, 1, 1, fast) < 1) return;
   if(CopyBuffer(hSlowEMA, 0, 1, 1, slow) < 1) return;
   if(CopyBuffer(hADX, 0, 1, 1, adx) < 1) return;
   if(CopyBuffer(hRSI, 0, 1, 1, rsi) < 1) return;

   // Bollinger: buffer 1 = upper, buffer 2 = lower
   if(CopyBuffer(hBB, 1, 1, 1, upper) < 1) return;
   if(CopyBuffer(hBB, 2, 1, 1, lower) < 1) return;

   if(CopyBuffer(hATR, 0, 1, 1, atr) < 1) return;

   MqlRates candle[];

   ArraySetAsSeries(candle, true);

   if(CopyRates(_Symbol, TradeTF, 1, 1, candle) < 1)
      return;

   double closePrice = candle[0].close;
   double atrValue = atr[0];

   if(atrValue <= 0)
      return;

   //====================== SIGNAL ======================

   bool buySignal = false;
   bool sellSignal = false;

   // TREND MODE
   if(adx[0] >= TrendADX)
   {
      if(fast[0] > slow[0] &&
         closePrice > fast[0] &&
         rsi[0] > 48)
      {
         buySignal = true;
      }

      if(fast[0] < slow[0] &&
         closePrice < fast[0] &&
         rsi[0] < 52)
      {
         sellSignal = true;
      }
   }

   // RANGE MODE
   else if(adx[0] <= RangeADX)
   {
      if(closePrice <= lower[0] && rsi[0] <= 45)
         buySignal = true;

      if(closePrice >= upper[0] && rsi[0] >= 55)
         sellSignal = true;
   }

   // Neutral ADX: tidak entry
   if(!buySignal && !sellSignal)
      return;

   //====================== ORDER ======================

   double slDistance = atrValue * SL_ATR;
   double tpDistance = atrValue * TP_ATR;

   if(buySignal)
   {
      double entry = tick.ask;

      double sl = NormalizeDouble(
         entry - slDistance,
         _Digits
      );

      double tp = NormalizeDouble(
         entry + tpDistance,
         _Digits
      );

      double lot = CalculateLot(
         ORDER_TYPE_BUY,
         entry,
         sl
      );

      if(lot > 0)
      {
         bool result = trade.Buy(
            lot,
            _Symbol,
            0,
            sl,
            tp,
            "HSC4 BUY"
         );

         if(result)
            Print("☑️ BUY | Lot: ", lot);
         else
            Print("❌ BUY ERROR: ", trade.ResultRetcodeDescription());
      }
   }

   else if(sellSignal)
   {
      double entry = tick.bid;

      double sl = NormalizeDouble(
         entry + slDistance,
         _Digits
      );

      double tp = NormalizeDouble(
         entry - tpDistance,
         _Digits
      );

      double lot = CalculateLot(
         ORDER_TYPE_SELL,
         entry,
         sl
      );

      if(lot > 0)
      {
         bool result = trade.Sell(
            lot,
            _Symbol,
            0,
            sl,
            tp,
            "HSC4 SELL"
         );

         if(result)
            Print("☑️ SELL | Lot: ", lot);
         else
            Print("❌ SELL ERROR: ", trade.ResultRetcodeDescription());
      }
   }
}

//====================== DEINIT ======================

void OnDeinit(const int reason)
{
   IndicatorRelease(hFastEMA);
   IndicatorRelease(hSlowEMA);
   IndicatorRelease(hADX);
   IndicatorRelease(hRSI);
   IndicatorRelease(hBB);
   IndicatorRelease(hATR);

   Print("HYBRID SCALPING V4 STOPPED");
}
