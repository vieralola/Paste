   DrawLabel("NSM_Pos",StringFormat("Positions: %d / %d",gPositions,MaxPositions),x,y,10,white); y+=lh;

   // Account
   DrawLabel("NSM_Bal", StringFormat("Balance: %.2f  Equity: %.2f",bal,eq),x,y,9,white); y+=lh;
   DrawLabel("NSM_DD",  StringFormat("Peak DD: %.2f%%  FreeMargin: %.2f",ddPct,freeM),x,y,9,
             (ddPct>10?red:white)); y+=lh;

   // Spread & last action
   DrawLabel("NSM_Spread",StringFormat("Spread: %.0f pts  Max: %d",gSpreadPts,MaxSpreadPts),x,y,9,
             (IsSpreadTooWide()?red:white)); y+=lh;
   DrawLabel("NSM_Action","Last: "+gLastAction+" @ "+TimeToString(gLastActionTime,TIME_MINUTES),x,y,8,gray);
}

