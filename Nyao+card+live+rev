//+------------------------------------------------------------------+
void OnTick()
{
   UpdateSpread();

   // Trailing setiap tick
   ManageTrailing();

   if(ShowDashboard)
      UpdateDashboard();

   datetime currentBar = iTime(_Symbol,_Period,0);
   if(currentBar==0) return;

   // Candle close hanya evaluasi saat candle baru
   if(EntryMode==ENTRY_CANDLE_CLOSE)
   {
      if(currentBar==lastBarTime) return;
      lastBarTime=currentBar;
   }

   // Maksimal satu entry setiap candle
   if(lastEntryBarTime==currentBar) return;

   if(!IsWithinTradingHours())
   {
      gLastAction="blocked: time";
      SetAction();
      return;
   }

   if(IsSpreadTooWide())
   {
      gLastAction="blocked: spread";
      SetAction();
      return;
   }

   int signalShift = (EntryMode==ENTRY_INSTANT) ? 0 : 1;

   if(!ComputeSignals(signalShift,gBuyScore,gSellScore,
                      gBuyReason,gSellReason))
      return;

   gPositions=CountPositions();

   if(gPositions>=MaxPositions)
   {
      gLastAction="blocked: max positions";
      SetAction();
      return;
   }

   bool htfUp=false, htfDn=false;

   if(UseHTFFilter)
      GetHTFDirection(htfUp,htfDn);

   
//==================== AUTO REVERSAL ====================

ENUM_ORDER_TYPE signalType;
bool validSignal = false;

if(gBuyScore >= MinBuyScore && gBuyScore > gSellScore)
{
   signalType = ORDER_TYPE_BUY;
   validSignal = true;
}
else if(gSellScore >= MinSellScore && gSellScore > gBuyScore)
{
   signalType = ORDER_TYPE_SELL;
   validSignal = true;
}

if(!validSignal)
{
   gLastAction = StringFormat("wait: B%.1f S%.1f",
                              gBuyScore,gSellScore);
   SetAction();
   return;
}

ENUM_ORDER_TYPE orderType = signalType;

if(AutoReversal)
{
   orderType = (signalType == ORDER_TYPE_BUY)
               ? ORDER_TYPE_SELL
               : ORDER_TYPE_BUY;
}

// HTF mengikuti arah transaksi aktual
if(UseHTFFilter)
{
   if(orderType == ORDER_TYPE_BUY && !htfUp)
   {
      gLastAction = "blocked: HTF down";
      SetAction();
      return;
   }

   if(orderType == ORDER_TYPE_SELL && !htfDn)
   {
      gLastAction = "blocked: HTF up";
      SetAction();
      return;
   }
}

if(OpenTrade(orderType))
{
   lastEntryBarTime = currentBar;

   gLastAction = (orderType == ORDER_TYPE_BUY)
                 ? "BUY opened"
                 : "SELL opened";

   if(AutoReversal)
      gLastAction += " [REVERSAL]";

   SetAction();
}

}

