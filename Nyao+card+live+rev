//--- Inputs
input group "=== Signal Settings ==="
input int    TrendRangeBars   = 100;   // Range Lookback (bars)
input int    TrendEMAPeriod   = 50;    // EMA Period
input int    TrendERBars      = 50;    // Efficiency Ratio Lookback
input int    TrendROCBars     = 30;    // Momentum Lookback
input int    TrendATRPeriod   = 14;    // ATR Period
input int    SmoothCandles    = 3;     // Smoothing Candles (closed)
input double MinBuyScore      = 6.0;   // Min Buy Score (0-10)
input double MinSellScore     = 6.0;   // Min Sell Score (0-10)
input ENUM_ENTRY_MODE EntryMode = ENTRY_CANDLE_CLOSE;
input bool AutoReversal = false; // Auto Reversal

input group "=== Trade Settings ==="
input double FixedLot         = 0.01;  // Fixed Lot
input int    MaxPositions     = 3;     // Max Concurrent Positions
input int    StopLossPts      = 150;   // Stop Loss (points)
input int    TakeProfitPts    = 300;   // Take Profit (points)
input int    MagicNumber      = 20241112;
input int    SlippagePts      = 20;

input group "=== Trailing ==="
input bool   EnableTrailing   = true;  // Enable Trailing Stop
input int    TrailStartPts    = 150;   // Start Trailing after X points
input int    TrailStepPts     = 100;   // Trail Distance (points)

input group "=== Filters ==="
input bool   UseHTFFilter     = false;  // Only trade with HTF trend
input ENUM_TIMEFRAMES HTF     = PERIOD_M5; // HTF timeframe
input int    HTFEMAPeriod     = 50;    // HTF EMA Period
input bool   UseSpreadFilter  = true;  // Block if spread too wide
input int    MaxSpreadPts     = 40;    // Max Spread (points)
input bool   UseTimeFilter    = false;  // Enable trading hours
input string StartTime        = "00:00"; // Start (HH:MM server)
input string EndTime          = "23:59"; // End   (HH:MM server)

input group "=== Dashboard ==="
input bool   ShowDashboard    = true;  // Show on-chart dashboard
input int    DashX            = 10;    // X position (px)
input int    DashY            = 20;    // Y position (px)
input bool   EnableLogging    = true;  // Print log

//--- Handles
int hEma=INVALID_HANDLE, hAtr=INVALID_HANDLE, hHtfEma=INVALID_HANDLE;

//--- State
datetime lastBarTime = 0;
datetime lastEntryBarTime = 0;
double   lastBuyScore=0, lastSellScore=0;
double   gBuyScore=0, gSellScore=0;
string   gBuyReason="", gSellReason="";
int      gPositions=0;
double   gSpreadPts=0;
string   gLastAction="idle";
datetime gLastActionTime=0;
double   gPeakEquity=0;

//+------------------------------------------------------------------+
int OnInit()
{
   //--- Force M1 (warning only, jangan fail — biar user lihat)
   if(Period()!=PERIOD_M1)
      Print("[WARN] EA ini dioptimasi untuk M1. TF saat ini: ", EnumToString((ENUM_TIMEFRAMES)Period()));

   hEma    = iMA(_Symbol, _Period, TrendEMAPeriod, 0, MODE_EMA, PRICE_CLOSE);
   hAtr    = iATR(_Symbol, _Period, TrendATRPeriod);
   if(UseHTFFilter)
      hHtfEma = iMA(_Symbol, HTF, HTFEMAPeriod, 0, MODE_EMA, PRICE_CLOSE);

   if(hEma==INVALID_HANDLE || hAtr==INVALID_HANDLE || (UseHTFFilter && hHtfEma==INVALID_HANDLE))
   {
      Print("Error membuat indicator handle");
      return INIT_FAILED;
   }

   gPeakEquity = AccountInfoDouble(ACCOUNT_EQUITY);
   EventSetTimer(1);
   Print("NyaoScalpM1 aktif. Symbol=", _Symbol, " TF=", EnumToString((ENUM_TIMEFRAMES)Period()));
   return INIT_SUCCEEDED;
}

//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
   EventKillTimer();
   if(hEma!=INVALID_HANDLE)    IndicatorRelease(hEma);
   if(hAtr!=INVALID_HANDLE)    IndicatorRelease(hAtr);
   if(hHtfEma!=INVALID_HANDLE) IndicatorRelease(hHtfEma);
   ObjectsDeleteAll(0, "NSM_");
   Comment("");
}

