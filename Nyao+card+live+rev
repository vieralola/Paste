//+------------------------------------------------------------------+
//| Signal Strength Model                                            |
//| 4 komponen: range, EMA distance, efficiency, momentum            |
//| semua -1..+1, rata-rata s, Buy=5+5s, Sell=5-5s                   |
//+------------------------------------------------------------------+
bool ComputeSignals(int startShift, double &buyScore, double &sellScore, string &buyReason, string &sellReason)
{
   buyScore=0; sellScore=0; buyReason=""; sellReason="";

   // Data closed candle [1] ke belakang
   int need = MathMax(TrendRangeBars, MathMax(TrendERBars, TrendROCBars)) + 5;

   double close[], high[], low[], ema[], atr[];
   ArraySetAsSeries(close,true); ArraySetAsSeries(high,true);
   ArraySetAsSeries(low,true);   ArraySetAsSeries(ema,true);
   ArraySetAsSeries(atr,true);

   if(CopyClose(_Symbol,_Period,startShift,need,close) < TrendRangeBars) return false;
   if(CopyHigh (_Symbol,_Period,startShift,TrendRangeBars,high) < TrendRangeBars) return false;
   if(CopyLow  (_Symbol,_Period,startShift,TrendRangeBars,low ) < TrendRangeBars) return false;
   if(CopyBuffer(hEma,0,startShift,1,ema) < 1) return false;
   if(CopyBuffer(hAtr,0,startShift,1,atr) < 1 || atr[0]<=0) return false;

   int rangeBars = TrendRangeBars;
   int erBars    = MathMin(TrendERBars, ArraySize(close)-1);
   int rocBars   = MathMin(TrendROCBars, ArraySize(close)-1);

   double c = close[0];

   // High/Low range
   int hiIdx = ArrayMaximum(high,0,rangeBars);
   int loIdx = ArrayMinimum(low ,0,rangeBars);
   double hi = high[hiIdx], lo = low[loIdx];

   double rangeComp = (hi>lo) ? (c - (hi+lo)/2.0)/((hi-lo)/2.0) : 0;
   if(rangeComp > 1) rangeComp = 1; if(rangeComp < -1) rangeComp = -1;

   // EMA distance in ATR
   double emaComp = MathTanh((c - ema[0]) / (4.0*atr[0]));

   // Efficiency
   double path = 0;
   for(int k=0;k<erBars;k++) path += MathAbs(close[k]-close[k+1]);
   double erComp = (path>0) ? MathTanh((c-close[erBars])/path/0.25) : 0;
   if(erComp>1) erComp=1; if(erComp<-1) erComp=-1;

   // Momentum
   double rocComp = MathTanh((c-close[rocBars])/(12.0*atr[0]));
   if(rocComp>1) rocComp=1; if(rocComp<-1) rocComp=-1;

   double s = (rangeComp + emaComp + erComp + rocComp)/4.0;

   double rawBuy  = 5.0 + 5.0*s;
   double rawSell = 5.0 - 5.0*s;

   // Smoothing mengikuti mode entry:
   // CANDLE_CLOSE: mulai shift 1
   // INSTANT: mulai shift 0
   int N = MathMax(1, SmoothCandles);
   double sumB=0, sumS=0, wt=0;

   for(int i=0; i<N; i++)
   {
      double sc = ComponentScore(startShift+i);
      double b  = 5.0 + 5.0*sc;
      double sel= 5.0 - 5.0*sc;
      double w  = (double)(N-i);
      sumB += b*w;
      sumS += sel*w;
      wt += w;
   }
   buyScore  = (wt>0) ? sumB/wt : rawBuy;
   sellScore = (wt>0) ? sumS/wt : rawSell;

   if(buyScore<0) buyScore=0; if(buyScore>10) buyScore=10;
   if(sellScore<0) sellScore=0; if(sellScore>10) sellScore=10;

   buyReason  = StringFormat("Rng:%+.2f EMA:%+.2f Eff:%+.2f Mom:%+.2f",
                             rangeComp, emaComp, erComp, rocComp);
   sellReason = buyReason;
   return true;
}

// Hitung s untuk candle ke-idx (1 = closed terakhir)
double ComponentScore(int idx)
{
   int need = MathMax(TrendRangeBars, MathMax(TrendERBars, TrendROCBars)) + 5;
   double close[], high[], low[], ema[], atr[];
   ArraySetAsSeries(close,true); ArraySetAsSeries(high,true);
   ArraySetAsSeries(low,true);   ArraySetAsSeries(ema,true); ArraySetAsSeries(atr,true);

   if(CopyClose(_Symbol,_Period,idx,need,close) < TrendRangeBars) return 0;
   if(CopyHigh (_Symbol,_Period,idx,TrendRangeBars,high) < TrendRangeBars) return 0;
   if(CopyLow  (_Symbol,_Period,idx,TrendRangeBars,low ) < TrendRangeBars) return 0;
   if(CopyBuffer(hEma,0,idx,1,ema) < 1) return 0;
   if(CopyBuffer(hAtr,0,idx,1,atr) < 1 || atr[0]<=0) return 0;

   int erBars  = MathMin(TrendERBars, ArraySize(close)-1);
   int rocBars = MathMin(TrendROCBars, ArraySize(close)-1);

   double c = close[0];
   double hi = high[ArrayMaximum(high,0,TrendRangeBars)];
   double lo = low [ArrayMinimum(low ,0,TrendRangeBars)];

   double rangeComp = (hi>lo) ? (c-(hi+lo)/2.0)/((hi-lo)/2.0) : 0;
   if(rangeComp>1) rangeComp=1; if(rangeComp<-1) rangeComp=-1;

   double emaComp = MathTanh((c-ema[0])/(4.0*atr[0]));

   double path=0;
   for(int k=0;k<erBars;k++) path+=MathAbs(close[k]-close[k+1]);
   double erComp = (path>0) ? MathTanh((c-close[erBars])/path/0.25) : 0;
   if(erComp>1) erComp=1; if(erComp<-1) erComp=-1;

   double rocComp = MathTanh((c-close[rocBars])/(12.0*atr[0]));
   if(rocComp>1) rocComp=1; if(rocComp<-1) rocComp=-1;

   return (rangeComp+emaComp+erComp+rocComp)/4.0;
}

//+------------------------------------------------------------------+
bool GetHTFDirection(bool &up, bool &down)
{
   up=false; down=false;
   if(hHtfEma==INVALID_HANDLE) return false;

   double ema[];
   ArraySetAsSeries(ema,true);
   if(CopyBuffer(hHtfEma,0,1,2,ema) < 2) return false;

   double htfClose = iClose(_Symbol, HTF, 1);
   if(htfClose<=0 || ema[0]<=0) return false;

   up   = (htfClose > ema[0] && ema[0] > ema[1]);
   down = (htfClose < ema[0] && ema[0] < ema[1]);
   return true;
}

//+------------------------------------------------------------------+
bool OpenTrade(ENUM_ORDER_TYPE type)
{
   double price = (type==ORDER_TYPE_BUY) ? SymbolInfoDouble(_Symbol,SYMBOL_ASK)
                                         : SymbolInfoDouble(_Symbol,SYMBOL_BID);
   double point = _Point;
   int    dg    = _Digits;

   double sl=0, tp=0;
   if(StopLossPts>0)
      sl = (type==ORDER_TYPE_BUY) ? price - StopLossPts*point : price + StopLossPts*point;
   if(TakeProfitPts>0)
      tp = (type==ORDER_TYPE_BUY) ? price + TakeProfitPts*point : price - TakeProfitPts*point;

   double lot = NormalizeLot(FixedLot);

   MqlTradeRequest req; MqlTradeResult res;
   ZeroMemory(req); ZeroMemory(res);
   req.action      = TRADE_ACTION_DEAL;
   req.symbol      = _Symbol;
   req.volume      = lot;
   req.type        = type;
   req.price       = NormalizeDouble(price, dg);
   req.sl          = (sl>0)?NormalizeDouble(sl,dg):0;
   req.tp          = (tp>0)?NormalizeDouble(tp,dg):0;
   req.deviation   = SlippagePts;
   req.magic       = MagicNumber;
   req.comment     = "NyaoScalpM1";
   req.type_filling= GetFilling();

   if(!OrderSend(req,res))
   {
      Print("OrderSend FAIL: ", GetLastError(), " retcode=", res.retcode);
      return false;
   }
   if(res.retcode!=TRADE_RETCODE_DONE)
   {
      Print("Order retcode=", res.retcode, " ", res.comment);
      return false;
   }
   Print("[ENTRY] ", (type==ORDER_TYPE_BUY?"BUY":"SELL"), " ", lot, " @", req.price,
         " SL=", req.sl, " TP=", req.tp);
   return true;
}

//+------------------------------------------------------------------+
ENUM_ORDER_TYPE_FILLING GetFilling()
{
   long fill = SymbolInfoInteger(_Symbol, SYMBOL_FILLING_MODE);
   if((fill & SYMBOL_FILLING_FOK)!=0) return ORDER_FILLING_FOK;
   if((fill & SYMBOL_FILLING_IOC)!=0) return ORDER_FILLING_IOC;
   return ORDER_FILLING_RETURN;
}

double NormalizeLot(double lot)
{
   double minL=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MIN);
   double maxL=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MAX);
   double step=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_STEP);
   if(step<=0) step=0.01;
   lot = MathMax(minL, MathMin(maxL, lot));
   lot = MathRound(lot/step)*step;
   int dg=0; double s=step;
   while(dg<8 && MathAbs(s-MathRound(s))>1e-9){ s*=10; dg++; }
   return NormalizeDouble(lot,dg);
}

//+------------------------------------------------------------------+
int CountPositions()
{
   int n=0;
   for(int i=PositionsTotal()-1;i>=0;i--)
   {
      ulong t=PositionGetTicket(i);
      if(t==0) continue;
      if(!PositionSelectByTicket(t)) continue;
      if(PositionGetInteger(POSITION_MAGIC)!=MagicNumber) continue;
      if(PositionGetString(POSITION_SYMBOL)!=_Symbol) continue;
      n++;
   }
   return n;
}

//+------------------------------------------------------------------+
void UpdateSpread()
{
   double ask=SymbolInfoDouble(_Symbol,SYMBOL_ASK);
   double bid=SymbolInfoDouble(_Symbol,SYMBOL_BID);
   gSpreadPts = (ask-bid)/_Point;
}

bool IsSpreadTooWide()
{
   return (UseSpreadFilter && gSpreadPts>MaxSpreadPts);
}

//+------------------------------------------------------------------+
bool IsWithinTradingHours()
{
   if(!UseTimeFilter) return true;

   MqlDateTime now; TimeToStruct(TimeCurrent(), now);
   int nowMin = now.hour*60 + now.min;

   int sh,sm,eh,em;
   if(!ParseHHMM(StartTime,sh,sm) || !ParseHHMM(EndTime,eh,em))
   {
      Print("Format jam salah. Pakai HH:MM");
      return true;
   }
   int startMin = sh*60+sm;
   int endMin   = eh*60+em;

   if(startMin<=endMin) return (nowMin>=startMin && nowMin<=endMin);
   return (nowMin>=startMin || nowMin<=endMin); // overnight
}

bool ParseHHMM(const string s,int &h,int &m)
{
   string p[];
   if(StringSplit(s,':',p)!=2) return false;
   h = (int)StringToInteger(p[0]);
   m = (int)StringToInteger(p[1]);
   return (h>=0 && h<24 && m>=0 && m<60);
}

//+------------------------------------------------------------------+
//| Trailing stop                                                    |
//+------------------------------------------------------------------+
void ManageTrailing()
{
   if(!EnableTrailing) return;
   for(int i=PositionsTotal()-1;i>=0;i--)
   {
      ulong t=PositionGetTicket(i);
      if(t==0) continue;
      if(!PositionSelectByTicket(t)) continue;
      if(PositionGetInteger(POSITION_MAGIC)!=MagicNumber) continue;
      if(PositionGetString(POSITION_SYMBOL)!=_Symbol) continue;

      long   ptype   = PositionGetInteger(POSITION_TYPE);
      double open    = PositionGetDouble(POSITION_PRICE_OPEN);
      double sl      = PositionGetDouble(POSITION_SL);
      double tp      = PositionGetDouble(POSITION_TP);
      double bid     = SymbolInfoDouble(_Symbol,SYMBOL_BID);
      double ask     = SymbolInfoDouble(_Symbol,SYMBOL_ASK);
      double point   = _Point;
      double newSL   = sl;

      if(ptype==POSITION_TYPE_BUY)
      {
         if((bid-open)/point >= TrailStartPts)
         {
            double cand = bid - TrailStepPts*point;
            if(sl==0 || cand > sl) newSL = cand;
         }
      }
      else
      {
         if((open-ask)/point >= TrailStartPts)
         {
            double cand = ask + TrailStepPts*point;
            if(sl==0 || cand < sl) newSL = cand;
         }
      }

      if(newSL!=sl && newSL>0)
      {
         MqlTradeRequest req; MqlTradeResult res;
         ZeroMemory(req); ZeroMemory(res);
         req.action   = TRADE_ACTION_SLTP;
         req.symbol   = _Symbol;
         req.position = t;
         req.sl       = NormalizeDouble(newSL,_Digits);
         req.tp       = tp;
         if(OrderSend(req,res) && res.retcode==TRADE_RETCODE_DONE)
            if(EnableLogging) Print("[TRAIL] pos ", t, " SL -> ", req.sl);
      }
   }
}

