//+------------------------------------------------------------------+
//|             VIERA AGGRESSIVE MULTI SCALPER                      |
//|             Multi Entry + Basket + Auto Reversal                |
//+------------------------------------------------------------------+
#property strict
#property version "1.20"

#include <Trade/Trade.mqh>
CTrade trade;

//======================
// LOT & POSITION
//======================
input group "=== LOT & POSITION ==="
input double FixedLot       = 0.01;
input int MaxPositions      = 5;
input ulong MagicNumber     = 24112026;

//======================
// SCALPING SIGNAL
//======================
input group "=== SCALPING SIGNAL ==="
input ENUM_TIMEFRAMES TradeTF = PERIOD_M1;
input int FastEMA           = 5;
input int SlowEMA           = 13;
input int RSIPeriod         = 7;
input double RSI_Buy        = 52;
input double RSI_Sell       = 48;

//======================
// ENTRY CONTROL
//======================
input group "=== ENTRY CONTROL ==="
input int CooldownSeconds   = 3;
input int MinDistancePoints = 100;
input int MaxSpreadPoints   = 40;

//======================
// BASKET TP SL
//======================
input group "=== BASKET MANAGEMENT ==="
input double BasketTP       = 1.50;
input double BasketSL       = 1.00;

input bool UseBasketTrail   = true;
input double TrailStart     = 0.60;
input double TrailLock      = 0.30;

//======================
// AUTO REVERSAL
//======================
input group "=== AUTO REVERSAL ==="
input bool EnableAutoReversal = true;
input int ReversalCooldown    = 2;

//======================
// INDIVIDUAL SL
//======================
input group "=== INDIVIDUAL SL ==="
input bool UseIndividualSL  = false;
input int IndividualSL      = 150;

//======================
// DASHBOARD
//======================
input group "=== DASHBOARD ==="
input bool ShowDashboard    = true;

//======================
// GLOBAL VARIABLES
//======================
int hFastEMA = INVALID_HANDLE;
int hSlowEMA = INVALID_HANDLE;
int hRSI     = INVALID_HANDLE;

datetime lastEntryTime = 0;
datetime lastReversalTime = 0;

double highestBasketProfit = 0;

int pendingReversal = 0;

bool basketClosing = false;

string EA_NAME = "VIERA AGGRESSIVE SCALPER";

//======================
// INITIALIZATION
//======================
int OnInit()
{
   trade.SetExpertMagicNumber(MagicNumber);
   trade.SetDeviationInPoints(20);
   trade.SetTypeFillingBySymbol(_Symbol);

   // Multi position requires hedging
   ENUM_ACCOUNT_MARGIN_MODE mode =
      (ENUM_ACCOUNT_MARGIN_MODE)AccountInfoInteger(
         ACCOUNT_MARGIN_MODE
      );

   if(mode != ACCOUNT_MARGIN_MODE_RETAIL_HEDGING)
   {
      Print("ERROR: EA membutuhkan akun HEDGING!");
      return INIT_FAILED;
   }

   hFastEMA = iMA(
      _Symbol,TradeTF,FastEMA,0,
      MODE_EMA,PRICE_CLOSE
   );

   hSlowEMA = iMA(
      _Symbol,TradeTF,SlowEMA,0,
      MODE_EMA,PRICE_CLOSE
   );

   hRSI = iRSI(
      _Symbol,TradeTF,RSIPeriod,PRICE_CLOSE
   );

   if(hFastEMA == INVALID_HANDLE ||
      hSlowEMA == INVALID_HANDLE ||
      hRSI == INVALID_HANDLE)
   {
      Print("Indicator initialization failed");
      return INIT_FAILED;
   }

   Print("================================");
   Print(EA_NAME," STARTED");
   Print("Basket TP: $",BasketTP);
   Print("Basket SL: $",BasketSL);
   Print("Auto Reversal: ",EnableAutoReversal);
   Print("================================");

   return INIT_SUCCEEDED;
}

//======================
// DEINITIALIZATION
//======================
void OnDeinit(const int reason)
{
   if(hFastEMA != INVALID_HANDLE)
      IndicatorRelease(hFastEMA);

   if(hSlowEMA != INVALID_HANDLE)
      IndicatorRelease(hSlowEMA);

   if(hRSI != INVALID_HANDLE)
      IndicatorRelease(hRSI);

   Comment("");
}

//======================
// COUNT POSITIONS
//======================
int CountPositions()
{
   int count = 0;

   for(int i=PositionsTotal()-1; i>=0; i--)
   {
      ulong ticket = PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(PositionGetString(POSITION_SYMBOL) == _Symbol &&
         PositionGetInteger(POSITION_MAGIC) == MagicNumber)
      {
         count++;
      }
   }

   return count;
}

//======================
// BASKET PROFIT
//======================
double BasketProfit()
{
   double total = 0;

   for(int i=PositionsTotal()-1; i>=0; i--)
   {
      ulong ticket = PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(PositionGetString(POSITION_SYMBOL) == _Symbol &&
         PositionGetInteger(POSITION_MAGIC) == MagicNumber)
      {
         total += PositionGetDouble(POSITION_PROFIT);
         total += PositionGetDouble(POSITION_SWAP);
      }
   }

   return total;
}

//======================
// COUNT BUY / SELL
//======================
void GetPositionCounts(int &buy,int &sell)
{
   buy = 0;
   sell = 0;

   for(int i=PositionsTotal()-1; i>=0; i--)
   {
      ulong ticket = PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(PositionGetString(POSITION_SYMBOL) != _Symbol ||
         PositionGetInteger(POSITION_MAGIC) != MagicNumber)
         continue;

      ENUM_POSITION_TYPE type =
         (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);

      if(type == POSITION_TYPE_BUY)
         buy++;

      if(type == POSITION_TYPE_SELL)
         sell++;
   }
}

//======================
// CLOSE BASKET
//======================
void CloseBasket()
{
   basketClosing = true;

   for(int i=PositionsTotal()-1; i>=0; i--)
   {
      ulong ticket = PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(PositionGetString(POSITION_SYMBOL) != _Symbol ||
         PositionGetInteger(POSITION_MAGIC) != MagicNumber)
         continue;

      if(!trade.PositionClose(ticket))
      {
         Print("CLOSE FAILED: ",
               ticket," ",
               trade.ResultRetcodeDescription());
      }
   }

   if(CountPositions() == 0)
   {
      highestBasketProfit = 0;
      basketClosing = false;
   }
}

//======================
// GET SIGNAL
//======================
int GetSignal()
{
   double fast[];
   double slow[];
   double rsi[];

   ArrayResize(fast,3);
   ArrayResize(slow,3);
   ArrayResize(rsi,3);

   ArraySetAsSeries(fast,true);
   ArraySetAsSeries(slow,true);
   ArraySetAsSeries(rsi,true);

   if(CopyBuffer(hFastEMA,0,0,3,fast)<3)
      return 0;

   if(CopyBuffer(hSlowEMA,0,0,3,slow)<3)
      return 0;

   if(CopyBuffer(hRSI,0,0,3,rsi)<3)
      return 0;

   // BUY
   if(fast[1] > slow[1] && rsi[1] >= RSI_Buy)
      return 1;

   // SELL
   if(fast[1] < slow[1] && rsi[1] <= RSI_Sell)
      return -1;

   return 0;
}

//======================
// CHECK OPPOSITE
//======================
bool HasOppositePosition(int direction)
{
   int buy,sell;

   GetPositionCounts(buy,sell);

   if(direction == 1 && sell > 0)
      return true;

   if(direction == -1 && buy > 0)
      return true;

   return false;
}

//======================
// CHECK ENTRY DISTANCE
//======================
bool CheckEntryDistance(int direction)
{
   double currentPrice =
      direction == 1 ?
      SymbolInfoDouble(_Symbol,SYMBOL_ASK):
      SymbolInfoDouble(_Symbol,SYMBOL_BID);

   for(int i=PositionsTotal()-1; i>=0; i--)
   {
      ulong ticket = PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(PositionGetString(POSITION_SYMBOL) != _Symbol ||
         PositionGetInteger(POSITION_MAGIC) != MagicNumber)
         continue;

      ENUM_POSITION_TYPE type =
         (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);

      if(direction == 1 && type != POSITION_TYPE_BUY)
         continue;

      if(direction == -1 && type != POSITION_TYPE_SELL)
         continue;

      double openPrice =
         PositionGetDouble(POSITION_PRICE_OPEN);

      double distance =
         MathAbs(currentPrice-openPrice)/_Point;

      if(distance < MinDistancePoints)
         return false;
   }

   return true;
}

//======================
// NORMALIZE LOT
//======================
double NormalizeLot(double lot)
{
   double minLot =
      SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MIN);

   double maxLot =
      SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MAX);

   double step =
      SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_STEP);

   if(step <= 0)
      return 0;

   lot = MathMax(minLot,MathMin(maxLot,lot));

   lot = MathFloor(lot/step+0.0000001)*step;

   int digits = 0;
   double temp = step;

   while(digits < 8 &&
         MathAbs(temp-MathRound(temp)) > 0.00000001)
   {
      temp *= 10;
      digits++;
   }

   return NormalizeDouble(lot,digits);
}

//======================
// OPEN POSITION
//======================
bool OpenPosition(int direction)
{
   if(direction == 0)
      return false;

   if(basketClosing)
      return false;

   if(CountPositions() >= MaxPositions)
      return false;

   if(HasOppositePosition(direction))
      return false;

   if(TimeCurrent()-lastEntryTime < CooldownSeconds)
      return false;

   if(!CheckEntryDistance(direction))
      return false;

   double lot = NormalizeLot(FixedLot);

   if(lot <= 0)
      return false;

   double sl = 0;

   if(UseIndividualSL)
   {
      if(direction == 1)
      {
         sl = SymbolInfoDouble(_Symbol,SYMBOL_ASK)
              - IndividualSL*_Point;
      }
      else
      {
         sl = SymbolInfoDouble(_Symbol,SYMBOL_BID)
              + IndividualSL*_Point;
      }

      sl = NormalizeDouble(sl,_Digits);
   }

   bool result = false;

   if(direction == 1)
   {
      result = trade.Buy(
         lot,_Symbol,0,sl,0,"VIERA BUY"
      );
   }
   else
   {
      result = trade.Sell(
         lot,_Symbol,0,sl,0,"VIERA SELL"
      );
   }

   uint retcode = trade.ResultRetcode();

   if(result &&
      (retcode == TRADE_RETCODE_DONE ||
       retcode == TRADE_RETCODE_DONE_PARTIAL ||
       retcode == TRADE_RETCODE_PLACED))
   {
      lastEntryTime = TimeCurrent();

      Print("ENTRY SUCCESS: ",
            direction == 1 ? "BUY":"SELL",
            " LOT: ",lot);

      return true;
   }

   Print("ENTRY FAILED: ",
         trade.ResultRetcodeDescription());

   return false;
}

//======================
// AUTO REVERSAL
//======================
void ManageAutoReversal(int signal)
{
   if(!EnableAutoReversal || signal == 0)
      return;

   if(pendingReversal != 0 || basketClosing)
      return;

   int buy,sell;

   GetPositionCounts(buy,sell);

   bool reverseBuy =
      signal == -1 && buy > 0;

   bool reverseSell =
      signal == 1 && sell > 0;

   if(!reverseBuy && !reverseSell)
      return;

   if(TimeCurrent()-lastReversalTime < ReversalCooldown)
      return;

   Print("================================");
   Print("AUTO REVERSAL ACTIVATED");
   Print("OLD DIRECTION: ",
         reverseBuy ? "BUY":"SELL");
   Print("NEW DIRECTION: ",
         signal == 1 ? "BUY":"SELL");
   Print("================================");

   // Save new direction
   pendingReversal = signal;

   // Close all old positions
   CloseBasket();

   lastReversalTime = TimeCurrent();
}

//======================
// PROCESS REVERSAL
//======================
void ProcessReversal()
{
   if(pendingReversal == 0)
      return;

   // Wait until all old positions are closed
   if(CountPositions() > 0)
   {
      CloseBasket();
      return;
   }

   if(basketClosing)
      return;

   // Spread filter
   double ask = SymbolInfoDouble(_Symbol,SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol,SYMBOL_BID);

   double spread = (ask-bid)/_Point;

   if(spread > MaxSpreadPoints)
      return;

   if(TimeCurrent()-lastReversalTime < ReversalCooldown)
      return;

   int direction = pendingReversal;

   if(OpenPosition(direction))
   {
      pendingReversal = 0;

      Print("REVERSAL SUCCESS: ",
            direction == 1 ? "BUY":"SELL");
   }
}

//======================
// BASKET MANAGEMENT
//======================
void ManageBasket()
{
   int positions = CountPositions();

   if(positions == 0)
   {
      highestBasketProfit = 0;
      basketClosing = false;
      return;
   }

   double profit = BasketProfit();

   // BASKET TP
   if(profit >= BasketTP)
   {
      Print("BASKET TP HIT: ",profit);

      pendingReversal = 0;

      CloseBasket();
      return;
   }

   // BASKET SL
   if(profit <= -BasketSL)
   {
      Print("BASKET SL HIT: ",profit);

      pendingReversal = 0;

      CloseBasket();
      return;
   }

   // BASKET TRAILING
   if(UseBasketTrail)
   {
      if(profit >= TrailStart)
      {
         if(profit > highestBasketProfit)
            highestBasketProfit = profit;
      }

      if(highestBasketProfit >= TrailStart)
      {
         double lockProfit =
            highestBasketProfit-TrailLock;

         if(profit <= lockProfit)
         {
            Print("BASKET TRAILING HIT: ",profit);

            pendingReversal = 0;

            CloseBasket();
            return;
         }
      }
   }
}

//======================
// MARKET CONDITION
//======================
string MarketCondition()
{
   double fast[];
   double slow[];

   ArrayResize(fast,3);
   ArrayResize(slow,3);

   ArraySetAsSeries(fast,true);
   ArraySetAsSeries(slow,true);

   if(CopyBuffer(hFastEMA,0,0,3,fast)<3)
      return "LOADING";

   if(CopyBuffer(hSlowEMA,0,0,3,slow)<3)
      return "LOADING";

   double gap =
      MathAbs(fast[1]-slow[1])/_Point;

   if(gap < 30)
      return "SIDEWAYS";

   return "TREND";
}

//======================
// DASHBOARD
//======================
void Dashboard()
{
   if(!ShowDashboard)
   {
      Comment("");
      return;
   }

   int buy,sell;

   GetPositionCounts(buy,sell);

   double profit = BasketProfit();

   string direction =
      buy > 0 ? "BUY":
      sell > 0 ? "SELL":"WAITING";

   string reversal =
      pendingReversal == 1 ? "PENDING BUY":
      pendingReversal == -1 ? "PENDING SELL":
      "READY";

   string status =
      basketClosing ? "CLOSING":"ACTIVE";

   string dash = StringFormat(
      "\n"
      "================================\n"
      "    VIERA AGGRESSIVE SCALPER\n"
      "================================\n"
      " SYMBOL       : %s\n"
      " TIMEFRAME    : %s\n"
      " MARKET       : %s\n"
      " DIRECTION    : %s\n"
      "--------------------------------\n"
      " BUY          : %d\n"
      " SELL         : %d\n"
      " POSITIONS    : %d / %d\n"
      "--------------------------------\n"
      " FLOATING     : $%.2f\n"
      " BASKET TP    : $%.2f\n"
      " BASKET SL    : -$%.2f\n"
      " TRAIL PEAK   : $%.2f\n"
      "--------------------------------\n"
      " AUTO REVERSAL: %s\n"
      " REVERSAL     : %s\n"
      "--------------------------------\n"
      " EA STATUS    : %s\n"
      "================================",
      _Symbol,
      EnumToString(TradeTF),
      MarketCondition(),
      direction,
      buy,
      sell,
      buy+sell,
      MaxPositions,
      profit,
      BasketTP,
      BasketSL,
      highestBasketProfit,
      EnableAutoReversal ? "ON":"OFF",
      reversal,
      status
   );

   Comment(dash);
}

//======================
// MAIN TICK
//======================
void OnTick()
{
   // 1. Manage basket first
   ManageBasket();

   // 2. Dashboard
   Dashboard();

   // 3. Wait for closing
   if(basketClosing)
      return;

   // 4. Process pending reversal
   if(pendingReversal != 0)
   {
      ProcessReversal();
      return;
   }

   // 5. Spread filter
   double ask = SymbolInfoDouble(_Symbol,SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol,SYMBOL_BID);

   double spread = (ask-bid)/_Point;

   if(spread > MaxSpreadPoints)
      return;

   // 6. Get signal
   int signal = GetSignal();

   if(signal == 0)
      return;

   // 7. Auto reversal
   ManageAutoReversal(signal);

   if(pendingReversal != 0 || basketClosing)
      return;

   // 8. Normal entry
   OpenPosition(signal);
}
